rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Visitor counter — public read + public write for the stats doc only.
    // Field validation kept simple to avoid subtle rule eval issues with
    // server-side transforms (FieldValue.increment / serverTimestamp).
    match /visitors/stats {
      allow read: if true;
      allow write: if true;
    }

    // Visitor locations — public read + public create. No update or delete allowed for security.
    match /visitor_locations/{locationId} {
      allow read, create: if true;
    }

    // First-party analytics — sessions can be created and updated (rollup
    // counters merge on every flush) but never deleted. Events are
    // append-only. Reads are public: the /analytics dashboard is an
    // unauthenticated client, and the data contains no PII beyond what
    // visitor_locations already exposes.
    match /analytics_sessions/{sessionId} {
      allow read, create, update: if true;

      match /events/{eventId} {
        allow read, create: if true;
      }
    }

    // All other documents — deny by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
